<Window x:Class="GmnaoCompanion.ShadowplayOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">

    <Border Background="#F0101109" CornerRadius="10" Padding="20"
            BorderBrush="#3A3D2B" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.8" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel Width="290">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="6" Height="6" CornerRadius="3" Background="#C8842A"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Battlefield 6 gestartet" FontSize="12" FontWeight="SemiBold"
                           Foreground="#807F6C" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Divider -->
            <Border Height="1" Background="#3A3D2B" Margin="0,0,0,14"/>

            <!-- Question -->
            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#ECE8DD"
                       TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="22">
                Ist die <Run Foreground="#E0A445">Shadowplay</Run>-Aufzeichnung<LineBreak/>aktiviert?
            </TextBlock>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <Button x:Name="NoButton" Content="Nein" Click="OnNo_Click"
                        Margin="0,0,8,0" Width="80" Height="32"
                        Foreground="#807F6C" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#1C1E14" CornerRadius="6"
                                    BorderBrush="#3A3D2B" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#24271A"/>
                                    <Setter Property="Foreground" Value="#B9B7A4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="YesButton" Content="Ja, läuft ✓" Click="OnYes_Click"
                        Width="110" Height="32"
                        Foreground="#ECE8DD" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#8A5C1E" CornerRadius="6"
                                    BorderBrush="#C8842A" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#C8842A"/>
                                    <Setter Property="Foreground" Value="#ECE8DD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Countdown -->
            <TextBlock x:Name="CountdownText"
                       FontSize="10" Foreground="#5A5A49"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
